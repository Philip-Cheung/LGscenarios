{
  "name": "doorstep-practice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && npm run check:ui-boundary",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "check:ui-boundary": "tsx scripts/check-ui-boundary.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "scenario:publish": "tsx scripts/publish-scenario.ts",
    "scenario:schema": "tsx scripts/scenario-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:push": "tsx scripts/db-push.ts",
    "validate": "npm run typecheck && npm run lint && npm run content:validate && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "ui-ux-pro-max-cli": "^2.15.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
