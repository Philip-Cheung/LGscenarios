# Public frontend configuration. Vite bundles VITE_* values into the build at
# build time, so they are visible to every visitor. Only put public values here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional. Set when Cloudflare Turnstile CAPTCHA is enabled in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Test-only settings. Copy to .env.test.local (git-ignored) and point at a
# dedicated TEST Supabase project. Never use production here: the integration
# and E2E suites create sessions and rewrite timestamps directly.
# ---------------------------------------------------------------------------
# TEST_SUPABASE_URL=https://your-test-project-ref.supabase.co
# TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Direct Postgres connection string (Session pooler or direct), percent-encoded.
# TEST_DATABASE_URL=postgresql://postgres.your-test-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# Required confirmation that the project above is disposable.
# TEST_PROJECT_IS_DISPOSABLE=yes
# Only if CAPTCHA is enabled on the test project with Cloudflare's always-pass
# test secret key; then use Cloudflare's dummy token here.
# TEST_CAPTCHA_TOKEN=
